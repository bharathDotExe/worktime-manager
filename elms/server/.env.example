# --- Server ---
PORT=4000
NODE_ENV=development

# Exact frontend origin. NEVER use "*".
CORS_ORIGIN=http://localhost:5173

# --- Database (Supabase-compatible Postgres connection string) ---
# Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres
# Set to "false" only for a local Postgres without TLS
PGSSL=true

# --- Auth ---
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_me_with_a_long_random_value
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12

# --- Manager seed (used ONLY by seed.js, never exposed via API) ---
MANAGER_USERNAME=manager@gcu.in
MANAGER_SEED_PASSWORD=replace_me_strong_password
# Optional demo employee created by seed.js
DEMO_EMPLOYEE_USERNAME=employee@gcu.in
DEMO_EMPLOYEE_PASSWORD=replace_me_strong_password

# --- Uploads ---
MAX_UPLOAD_MB=5
UPLOAD_DIR=uploads
